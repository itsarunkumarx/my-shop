# Security
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=False

# Allowed Hosts & CSRF Origins (Comma-separated)
ALLOWED_HOSTS=.vercel.app,.onrender.com,.railway.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-app-name.vercel.app,https://your-app-name.onrender.com

# Database (PostgreSQL / MySQL URL from Neon.tech, Supabase, Render, or Railway)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional: Cloudinary for cloud media storage
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
